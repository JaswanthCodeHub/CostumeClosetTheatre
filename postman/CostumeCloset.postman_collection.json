  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "1 - Actors CRUD",
      "item": [
        {
          "name": "Get All Actors",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/actors", "host": ["{{baseUrl}}"], "path": ["actors"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
            "pm.test('Has seed actors', () => pm.expect(pm.response.json().length).to.be.at.least(10));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Get Actor by ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/actors/1", "host": ["{{baseUrl}}"], "path": ["actors","1"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has id and name', () => { var d = pm.response.json(); pm.expect(d).to.have.property('id', 1); pm.expect(d).to.have.property('name'); });"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Get Actor - Not Found",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/actors/999", "host": ["{{baseUrl}}"], "path": ["actors","999"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Add Actor",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"name\": \"TestActor\"}" }, "url": { "raw": "{{baseUrl}}/actors", "host": ["{{baseUrl}}"], "path": ["actors"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Returns id and name', () => { var d = pm.response.json(); pm.expect(d).to.have.property('id'); pm.expect(d.name).to.eql('TestActor'); });",
            "pm.collectionVariables.set('newActorId', pm.response.json().id);"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Update Actor",
          "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"name\": \"UpdatedActor\"}" }, "url": { "raw": "{{baseUrl}}/actors/{{newActorId}}", "host": ["{{baseUrl}}"], "path": ["actors","{{newActorId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.eql('UpdatedActor'));"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "Delete Actor",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/actors/{{newActorId}}", "host": ["{{baseUrl}}"], "path": ["actors","{{newActorId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ], "type": "text/javascript" } }]
        }
